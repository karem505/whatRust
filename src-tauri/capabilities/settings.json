{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-local",
  "description": "Local IPC for the settings window: settings, accounts and app-lock management.",
  "permissions": [
    "core:default",
    "allow-get-settings",
    "allow-set-settings",
    "allow-pick-download-dir",
    "allow-choose-app-icon",
    "allow-reset-app-icon",
    "allow-restart-app",
    "allow-list-accounts",
    "allow-add-account",
    "allow-remove-account",
    "allow-rename-account",
    "allow-open-account",
    "allow-set-default-account",
    "allow-get-lock-status",
    "allow-set-app-lock-password",
    "allow-change-app-lock-password",
    "allow-disable-app-lock",
    "allow-set-app-lock-options",
    "allow-set-biometric-enabled",
    "allow-lock-app",
    "allow-get-update-status",
    "allow-check-for-updates",
    "allow-install-update",
    "allow-restart-to-update",
    "allow-open-release-page",
    "allow-open-app-panel",
    "allow-close-app-panel",
    "allow-detach-account",
    "allow-attach-account",
    "allow-reorder-accounts",
    "allow-notification-diagnostics",
    "allow-test-notification",
    "allow-open-notification-settings"
  ],
  "webviews": [
    "settings"
  ]
}
