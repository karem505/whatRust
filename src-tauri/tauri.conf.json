{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "whatRust",
  "version": "0.6.3",
  "identifier": "com.karem.whatrust",
  "build": {
    "frontendDist": "../settings-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": [
        {
          "schemes": ["whatsapp"]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "app", "dmg", "nsis", "msi"],
    "macOS": {
      "minimumSystemVersion": "12.1"
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/polkit-1/actions/com.karem.whatrust.policy": "resources/com.karem.whatrust.policy"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}